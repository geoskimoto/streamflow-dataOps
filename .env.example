DATABASE_URL=sqlite:///./streamflow_dev.db
# DATABASE_URL=postgresql://user:password@localhost:5432/streamflow_db

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# NASA EarthData Authentication
# Sign up at: https://urs.earthdata.nasa.gov/users/new
# Required for SMAP, GPM, MODIS satellite data access
EARTHDATA_USERNAME=your_username_here
EARTHDATA_PASSWORD=your_password_here

# ResidCast Forecast Service
# Local development: http://127.0.0.1:8001
# Production: set to deployed ResidCast service URL
RESIDCAST_API_BASE=http://127.0.0.1:8001
RESIDCAST_API_TOKEN=your-bearer-token-here
